<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.plantcare">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="PlantCare"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlantCare"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="PlantCare"
            android:theme="@style/Theme.PlantCare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Vista1Activity"
            android:exported="true"
            android:label="Paso 1"
            android:theme="@style/Theme.PlantCare" />


        <activity
            android:name=".Vista2Activity"
            android:exported="false"
            android:label="Paso 2"
            android:theme="@style/Theme.PlantCare" />

        <activity
            android:name=".Vista3Activity"
            android:exported="false"
            android:label="Paso 3"
            android:theme="@style/Theme.PlantCare" />


        <activity
            android:name=".Vista4Activity"
            android:exported="false"
            android:label="Paso 4"
            android:theme="@style/Theme.PlantCare" />

    </application>

</manifest>

